# Supabase (self-hosted, see infra/supabase for the full generated set)
SUPABASE_URL=http://127.0.0.1:8000
POSTGRES_PASSWORD=replace-with-generated-password
JWT_SECRET=replace-with-generated-32-char-secret
ANON_KEY=replace-with-generated-anon-key
SERVICE_ROLE_KEY=replace-with-generated-service-role-key

# --- Two Postgres connection strings, same DB, different callers:
#   * DATABASE_URL          -> host-side tooling ONLY (psql, `uv run pytest`,
#                              running api/worker directly on the host).
#   * DATABASE_URL_INTERNAL -> ANY service that runs *inside* Docker Compose
#                              (infra/docker-compose.yml's api/worker, and any
#                              future containerized service). Always reach for
#                              this one from a Dockerfile/compose service.
# See the matching comment block in the real .env for the full explanation.

# Host-side tooling only - see rule above.
DATABASE_URL=postgresql://postgres.replace-with-tenant-id:replace-with-generated-password@localhost:5432/postgres

# Docker Compose services only - see rule above.
DATABASE_URL_INTERNAL=postgresql://postgres.replace-with-tenant-id:replace-with-generated-password@supavisor:5432/postgres

# Next.js (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-generated-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub OAuth (create an OAuth app with callback:
# http://127.0.0.1:8000/auth/v1/callback)
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
